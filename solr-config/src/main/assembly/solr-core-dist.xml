<?xml version="1.0" encoding="UTF-8"?>

<assembly>
    <!--
        Create a tar.gz file containing
    -->
    <id>solr-core</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Copy everything in solr/portal/conf to ehri/portal/conf -->
    <fileSets>
        <fileSet>
            <directory>${basedir}/core/</directory>
            <outputDirectory>/</outputDirectory>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
            <includes>
                <include>*</include>
                <include>*/*</include>
                <include>*/*/*</include>
                <include>*/*/*/*</include>
            </includes>
        </fileSet>
    </fileSets>

    <!-- Copy select dependencies to ehri/lib -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>/lib-${solr.version}</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
            <unpack>false</unpack>
            <useProjectArtifact>false</useProjectArtifact>
            <useStrictFiltering>true</useStrictFiltering>
            <includes>
                <include>com.ibm.icu:icu4j</include>
                <include>org.apache.solr:solr-analysis-extras</include>
                <include>org.apache.lucene:lucene-analysis-icu</include>
                <include>org.apache.lucene:lucene-analysis-morfologik</include>
                <include>org.apache.lucene:lucene-analysis-smartcn</include>
                <include>org.apache.lucene:lucene-analysis-stempel</include>
                <include>org.carrot2:morfologik-fsa</include>
                <include>org.carrot2:morfologik-stemming</include>
                <include>org.carrot2:morfologik-polish</include>
                <include>ua.net.nlp:morfologik-ukrainian-search</include>
                <include>org.apache.solr:solr-langid</include>
                <include>io.github.azagniotov:language-detection</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>

